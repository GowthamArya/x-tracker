{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/server/server.csproj"
    },
    {
      "name": "Client",
      "type": "node-terminal",
      "request": "launch",
      "command": "ionic serve --port 8100",
      "cwd": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "XTracker - Debug",
      "configurations": [
        "API",
        "Client"
      ],
      "stopAll": true
    }
  ]
}